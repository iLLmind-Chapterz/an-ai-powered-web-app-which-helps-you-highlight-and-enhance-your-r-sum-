rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validations ---
    function isValidAnalysis(data) {
      return data.keys().hasAll(['userId', 'jobTitle', 'resumeText', 'jdText', 'result', 'createdAt', 'updatedAt'])
        && data.keys().size() == 7
        && data.userId == request.auth.uid
        && data.jobTitle is string && data.jobTitle.size() <= 200
        && data.resumeText is string && data.resumeText.size() <= 60000
        && data.jdText is string && data.jdText.size() <= 60000
        && data.result is map;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['xp', 'level', 'updatedAt'])
        && data.keys().size() == 3
        && data.xp is number && data.xp >= 0
        && data.level is number && data.level >= 1
        && data.updatedAt == request.time;
    }

    // --- Collections ---

    // 1. Analyses Collection
    match /analyses/{analysisId} {
      allow create: if isSignedIn() && isValidId(analysisId) && isValidAnalysis(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      
      allow update: if isSignedIn() && isValidId(analysisId) && isValidAnalysis(incoming())
        && incoming().updatedAt == request.time
        && incoming().createdAt == existing().createdAt
        && incoming().userId == existing().userId
        && incoming().diff(existing()).affectedKeys().hasOnly(['jobTitle', 'resumeText', 'jdText', 'result', 'updatedAt']);

      // Allow user to see their own history
      allow get: if isOwner(existing().userId) && isValidId(analysisId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      // Analyses can be deleted by owner
      allow delete: if isOwner(existing().userId) && isValidId(analysisId);
    }

    // 2. Users Collection (Profile/Gamification)
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidUserProfile(incoming()) 
        && incoming().diff(existing()).affectedKeys().hasOnly(['xp', 'level', 'updatedAt']);
    }
  }
}
